{
  "name": "limen-firewall",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "electron .",
    "desktop:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "zustand": "^5.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.13"
  },
  "version": "1.3.0",
  "description": "Windows connection monitor and Windows Firewall rule manager",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "DataProtector-collab",
  "repository": {
    "type": "git",
    "url": "https://github.com/DataProtector-collab/limen-firewall.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
